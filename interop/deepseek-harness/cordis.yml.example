# DeepSeek Harness（dsh）本地挂载 dev-agent 能力
#
# 官方插件规范：docs/user/develop/basic/index.md（insert 块 + --patch 本地加载）
#   运行：pnpm dsh web --patch ./interop/deepseek-harness/cordis.yml
#
# 接入方式：官方 MCP 桥接插件 @deepseek-ai/dsh-mcp-client（stdio 传输），
# 把本项目的 MCP 服务器（mcp/review_mcp.py）的 4 个工具注册进 dsh，
# 工具名形如 mcp__code-review__code_review_run。
#
# autoApprove: [] —— 所有工具调用均弹出确认（安全默认）；指定工具名可免确认。
insert:
  - id: mcp-code-review
    name: '@deepseek-ai/dsh-mcp-client'
    config:
      serverName: code-review
      transport: stdio
      command: py
      args: ['-3', '<repo>/mcp/review_mcp.py']
      env:
        PYTHONIOENCODING: utf-8
      toolCallTimeoutMs: 600000
      autoApprove: []

# 原生工具插件形态（apply/inject/defineTool，见同目录 README.md
# 「原生工具插件」一节）的 insert 块形如：
#   - id: dev-agent
#     name: <repo>/interop/deepseek-harness/src/index.ts
