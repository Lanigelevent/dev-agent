++def _count_test_files(worktree, ct_mod_arg):
++    total = 0
++    for path in ct_mod_arg._discover_test_paths(worktree):
++        if path.is_dir():
++            total += len(list(path.rglob("test_*.py")))
++        elif path.is_file():
