+    if match and match.group(1).casefold() == needle:
+        return 0
+    stripped = line.lstrip()
+    pos = line.casefold().find(needle)
+    hash_pos = line.find("#")
+    if stripped.startswith("#") or (hash_pos != -1 and pos != -1
+                                    and hash_pos < pos):
+        return 2
+    return 1
+
