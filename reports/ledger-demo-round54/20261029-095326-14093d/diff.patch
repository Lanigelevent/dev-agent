+def _search_kind(line, needle):
+    """命中行分类：0=定义、1=引用、2=注释（越小越靠前，2.2）。
+
+    定义行优先的理由：模型搜一个符号时想找的是「它定义在哪」，而不是
+    「哪里提到过它」；注释行最后，因为注释里的名字不承载可执行语义。
+    """
