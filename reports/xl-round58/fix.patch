diff --git a/xlib/parsers.py b/xlib/parsers.py
index 4e8e936..8df8129 100644
--- a/xlib/parsers.py
+++ b/xlib/parsers.py
@@ -5,7 +5,11 @@ from decimal import Decimal, InvalidOperation
 def parse_amount(text):
     """'1,234.50' → Decimal('1234.50')；非法输入抛 ValueError。"""
     cleaned = text.strip().replace(",", "")
+    negative = cleaned.startswith("(") and cleaned.endswith(")")
+    if negative:
+        cleaned = cleaned[1:-1]
     try:
-        return Decimal(cleaned)
+        value = Decimal(cleaned)
+        return -value if negative else value
     except InvalidOperation:
         raise ValueError("无法解析金额: %r" % text)
diff --git a/xlib/report.py b/xlib/report.py
