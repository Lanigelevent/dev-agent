--- a/xlib/report.py
+++ b/xlib/report.py
@@ -3,5 +3,8 @@ from xlib.core import as_money
 
 
 def render(value):
-    """Decimal('1234.5') → '1,234.50'。"""
-    return "{:,.2f}".format(as_money(value))
+    """Accounting style: negative amounts are wrapped in parentheses."""
+    money = as_money(value)
+    if money < 0:
+        return "({:,.2f})".format(-money)
+    return "{:,.2f}".format(money)
